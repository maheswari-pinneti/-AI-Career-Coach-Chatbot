# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1

# Security & Secrets (generate secure random strings in production)
SECRET_KEY=change-this-in-production-dev-secret-key-32chars
JWT_SECRET_KEY=change-this-in-production-jwt-secret-key-32chars

# Database Configuration
DATABASE_URL=sqlite:///ai_career_coach.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Provider Configuration (mock | openai | huggingface)
AI_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
